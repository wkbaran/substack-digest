# Copy to docker/.env (gitignored) and fill in.

# Host directories (absolute paths on the Docker host).
DIGEST_DIR=/srv/substack-digest/state
AUTH_DIR=/srv/substack-digest/auth

# Time zone for the crontab and for dates in the digest.
TZ=UTC
SUBSTACK_DIGEST_TZ=UTC

# Any OpenAI-compatible gateway (a LiteLLM proxy, Ollama, OpenAI).
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=
# "none" turns Qwen's thinking off on Ollama.
LLM_REASONING_EFFORT=none

# Where the digest goes, and where failure notices go (defaults to the same webhook).
DISCORD_WEBHOOK_URL=
DISCORD_FAILURE_WEBHOOK_URL=

# Optional substack-reader-mcp settings; every SUBSTACK_* variable is passed to the server.
# A job waits as long as digest_begin needs; the server's default (250s) is sized for agent hosts.
SUBSTACK_DIGEST_FETCH_BUDGET=10min
# Pacing of Substack requests (see paced-fetch): SUBSTACK_RATE=60/min, SUBSTACK_CONCURRENCY, SUBSTACK_RETRIES…
# SUBSTACK_CLASSIFIER=jev
# SUBSTACK_JEV_URL=
# SUBSTACK_JEV_MODEL=
# SUBSTACK_JEV_API_KEY=
# SUBSTACK_DIGEST_RANK_FLOOR=0.3
